rules_version = '2';

// Each signed-in user can read/write ONLY /users/{theirOwnUid} and everything below it
// (dailyLogs, weightLogs, waterLogs, achievements). Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /{subcollection}/{docId} {
        allow read, write: if isOwner(uid)
          && subcollection in ['dailyLogs', 'weightLogs', 'waterLogs', 'achievements'];
      }
    }

    // ── Friends ───────────────────────────────────────────────
    // Friend code → uid lookup. Anyone signed in may GET a single code (not list them).
    match /friendCodes/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Shared progress SUMMARY (no journal / food / raw logs). Readable by the owner and
    // by users listed in its followers subcollection.
    match /publicStats/{uid} {
      allow read: if isOwner(uid)
        || (request.auth != null && exists(/databases/$(database)/documents/publicStats/$(uid)/followers/$(request.auth.uid)));
      allow write: if isOwner(uid);

      // followers/{fid}: fid may read publicStats/{uid}.
      //  - the owner may add/remove anyone (adding someone back after entering THEIR code)
      //  - anyone may add THEMSELVES only by presenting the owner's current friend code
      //  - a follower may remove themselves
      match /followers/{fid} {
        allow read: if isOwner(uid) || request.auth.uid == fid;
        allow create, update: if isOwner(uid)
          || (request.auth != null && request.auth.uid == fid
              && request.resource.data.code == get(/databases/$(database)/documents/publicStats/$(uid)).data.friendCode);
        allow delete: if isOwner(uid) || (request.auth != null && request.auth.uid == fid);
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
