# Copy this file to `.env` and fill in values from
# Firebase Console → Project settings → General → Your apps → Web app → SDK setup and configuration.
#
# These Firebase WEB config values are NOT secrets (they ship to every browser anyway).
# Security comes from Firebase Authentication + firestore.rules.
#
# NEVER put here: private keys, service-account JSON, Firebase Admin credentials, SMTP/Gmail passwords.
#
# Leave them empty to run in LOCAL DEMO MODE (data stays in this browser only; users from src/config/localUsers.js).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
